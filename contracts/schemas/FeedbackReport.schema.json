          "type": "integer"
        },
        "main_answered": {
          "maximum": 6,
          "minimum": 0,
          "title": "Main Answered",
          "type": "integer"
        },
        "main_skipped": {
          "maximum": 6,
          "minimum": 0,
          "title": "Main Skipped",
          "type": "integer"
        },
