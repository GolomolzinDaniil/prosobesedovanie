        "related_turn_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Related Turn Id"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "priority",
        "text"
      ],
      "title": "ReportAction",
      "type": "object"
    },
    "ReportFinding": {
      "additionalProperties": false,
