# config/.env.example — названия секретов, контакта поддержки и путей (§3.6).
# Значения пустые. Секреты никогда не включаются в репозиторий.
# Рабочая копия: .env (в .gitignore), передаётся через env_file docker-compose.

# --- Обязательные секреты ---
# Токен бота от BotFather. Не логируется, не отправляется AI-провайдерам.
BOT_TOKEN=
# Секрет webhook: сравнивается с X-Telegram-Bot-Api-Secret-Token (неверный -> 403).
WEBHOOK_SECRET=
# Случайный route_token URL webhook; не содержит токен бота.
WEBHOOK_ROUTE_TOKEN=

# --- База данных (§3.9: разные роли для приложения, миграций и backup) ---
# Роль приложения (DML):
DATABASE_URL=postgresql://app:CHANGE_ME@db:5432/prosobesedovanie
# Роль миграций (DDL) — используется командой python -m app.storage.migrate:
MIGRATIONS_DATABASE_URL=postgresql://migrator:CHANGE_ME@db:5432/prosobesedovanie

# --- Ключи AI-провайдеров (имена из provider-profile.json: *_env) ---
LLM_API_KEY=
STT_API_KEY=
TTS_API_KEY=

# --- Пути и каталоги ---
SETTINGS_PATH=config/settings.json
QUESTIONS_PATH=config/questions.json
PRODUCTS_PATH=config/products.json
PROVIDER_PROFILE_PATH=config/provider-profile.json
PROMPTS_DIR=prompts
# Закрытая временная директория аудио (0700), не в постоянной базе:
MEDIA_DIR=/var/lib/prosobesedovanie/media
# Служебная директория (0700): heartbeat worker, статус backup (§3.10).
# Общий том api и worker в docker-compose (rundata):
RUN_DIR=/var/lib/prosobesedovanie/run

# --- API-процесс ---
API_HOST=0.0.0.0
API_PORT=8080
ENV_NAME=dev
LOG_LEVEL=INFO

# --- Эксплуатация (T23) ---
# Парольная фаза шифрования backup (AES-256-CBC); передаётся оператору через
# защищённое хранилище, в репозиторий и .env.production-примеры не включается:
# BACKUP_PASSPHRASE= (только в окружении cron/оператора, не в этом файле)
# Каталог скользящих (7 дней) резервных копий для scripts/backup.sh:
# BACKUP_DIR=/secure/backups
# Реальный контакт оператора поддержки (нужен до коммерческого этапа, /support):
SUPPORT_CONTACT=
# Публичный HTTPS-базовый URL (reverse proxy с TLS) для setWebhook:
PUBLIC_BASE_URL=
